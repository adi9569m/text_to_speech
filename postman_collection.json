{
  "info": {
    "_postman_id": "c61df7e2-4589-4e78-bc4a-tts-project-collection",
    "name": "Text-to-Speech API",
    "description": "Complete Postman Collection for the Full-Stack Text-to-Speech Application per Section 24 of Python -Text-to-Speech Application.pdf. Includes all 10 endpoints across Health, Voices, Synthesis, Document Upload, History, and Authentication with automated test assertion scripts and dynamic token chaining.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "Base URL of the FastAPI backend server"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "Dynamic session token auto-populated by Login and Register requests"
    },
    {
      "key": "sampleHistoryId",
      "value": "1",
      "type": "string",
      "description": "Sample history item ID used for item-level history operations"
    }
  ],
  "item": [
    {
      "name": "1. Health & System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Checks whether the backend server is online and operational (PDF Section 8 & 18)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response returns status ok\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"object\");",
                  "    pm.expect(jsonData.status).to.eql(\"ok\");",
                  "});",
                  "pm.test(\"Response time is under 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Text-to-Speech & Voices",
      "item": [
        {
          "name": "Get Available Voices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/voices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "voices"]
            },
            "description": "Fetches curated neural voices and supported languages (English, Hindi, Gujarati, Marathi, Spanish, French, German) (PDF Section 4.2 & 4.3)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Contains voices and languages arrays\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.voices).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(jsonData.languages).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "pm.test(\"Voice object contains id, name, gender, language\", function () {",
                  "    const firstVoice = pm.response.json().voices[0];",
                  "    pm.expect(firstVoice).to.have.property(\"id\");",
                  "    pm.expect(firstVoice).to.have.property(\"name\");",
                  "    pm.expect(firstVoice).to.have.property(\"gender\");",
                  "    pm.expect(firstVoice).to.have.property(\"language\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Generate Speech (Standard)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "description": "Optional: Attaches speech to authenticated user account if provided"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Welcome to our Text to Speech application powered by FastAPI and Neural TTS.\",\n  \"language\": \"English (US)\",\n  \"voice\": \"en-US-JennyNeural\",\n  \"rate\": \"+0%\",\n  \"pitch\": \"+0Hz\",\n  \"volume\": \"+0%\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Converts text input into high-quality neural speech audio (PDF Section 4.4 & 8)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns success and audio_url\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.audio_url).to.be.a(\"string\").that.includes(\"/audio/\");",
                  "    pm.expect(jsonData.filename).to.be.a(\"string\").that.endsWith(\".mp3\");",
                  "    pm.expect(jsonData.char_count).to.be.above(0);",
                  "    pm.expect(jsonData.word_count).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Generate Speech (Custom Rate & Pitch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Audio customization test with faster rate and higher pitch.\",\n  \"language\": \"English (US)\",\n  \"voice\": \"en-US-GuyNeural\",\n  \"rate\": \"+25%\",\n  \"pitch\": \"+10Hz\",\n  \"volume\": \"+0%\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Generates audio with custom speed and pitch configurations (PDF Section 17 Audio Customization)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Audio URL returned\", function () {",
                  "    pm.expect(pm.response.json().audio_url).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Error: Empty Text Input",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"\",\n  \"voice\": \"en-US-JennyNeural\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Validates that empty text is rejected with 422 Unprocessable Entity (PDF Section 14 & 18)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Error: Exceeds 1000 Character Limit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"This text is deliberately repeated to exceed the 1000 character maximum limit enforced by the API. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum. Repeating further: Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.\",\n  \"voice\": \"en-US-JennyNeural\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tts"]
            },
            "description": "Validates that requests exceeding 1,000 characters are rejected with 422 Unprocessable Entity (PDF Section 14 & 18)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Document Upload & Extraction",
      "item": [
        {
          "name": "Extract Text from Document (.txt or .pdf)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "contentType": "text/plain",
                  "value": "Welcome to our multi-format document extraction test.\nThis plain text document is extracted and prepared for speech synthesis.",
                  "type": "text",
                  "description": "Upload a .txt or .pdf file"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/extract-text",
              "host": ["{{baseUrl}}"],
              "path": ["api", "extract-text"]
            },
            "description": "Extracts text from uploaded TXT or PDF documents, normalizes whitespace, and truncates to 1000 characters (PDF Section 17 Text File Upload)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 400 (if file payload is not raw bytes)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Authentication (Level 2)",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_tester\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user account with PBKDF2 password hashing (PDF Section 17 & 25 Level 2). Automatically saves session_token to {{authToken}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 (created) or 400 (already exists)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.test(\"Returns user info and session token\", function () {",
                  "        pm.expect(jsonData).to.have.property(\"user\");",
                  "        pm.expect(jsonData).to.have.property(\"session_token\");",
                  "    });",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.session_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_tester\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user credentials and captures session_token into {{authToken}} for subsequent requests."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Extracts and chains authToken variable\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.session_token).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.session_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Validates the session token in Authorization header and returns current user data."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns authenticated user details\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.username).to.eql(\"postman_tester\");",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Error: Invalid Login Credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_tester\",\n  \"password\": \"WrongPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Ensures that invalid passwords are unauthorized with 401 status code."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Speech History",
      "item": [
        {
          "name": "Get Speech History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/history?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Retrieves speech history records scoped to the current user (or guest records if unauthenticated) (PDF Section 17 Speech History)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns history array and total count\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"history\");",
                  "    pm.expect(jsonData).to.have.property(\"total\");",
                  "    if (jsonData.history.length > 0) {",
                  "        pm.collectionVariables.set(\"sampleHistoryId\", jsonData.history[0].id.toString());",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Toggle Favorite Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/history/{{sampleHistoryId}}/favorite",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history", "{{sampleHistoryId}}", "favorite"]
            },
            "description": "Toggles favorite bookmark status for a speech history item (PDF Section 17 Favorites)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 404 (if ID does not exist)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Returns updated is_favorite boolean\", function () {",
                  "        const jsonData = pm.response.json();",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData).to.have.property(\"is_favorite\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Single History Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/history/{{sampleHistoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history", "{{sampleHistoryId}}"]
            },
            "description": "Deletes a specific history record by ID."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 404 Not Found\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Clear All History",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history"]
            },
            "description": "Clears all speech history records scoped to current user session."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns success true\", function () {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
